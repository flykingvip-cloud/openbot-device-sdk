{
  "name": "@flykingvip-cloud/openbot-device-sdk",
  "version": "0.1.0",
  "description": "Agent A device platform: Metalio voice adapter, device tools/media, and a lab-only claim/bind/OTA control plane.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/npm-publish.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flykingvip-cloud/openbot-device-sdk.git"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:publish": "node scripts/build-voice-dist.mjs",
    "prepack": "npm run build:publish",
    "pack:check": "node scripts/pack-check.mjs",
    "publish:dry-run": "npm publish --dry-run",
    "console": "node --disable-warning=ExperimentalWarning --experimental-strip-types console/src/cli.ts",
    "sim": "node --disable-warning=ExperimentalWarning --experimental-strip-types simulator/src/cli.ts",
    "ota-config": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/ota-config-cli.ts",
    "device-control": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/device-control-cli.ts",
    "sim-joint": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/sim-joint-cli.ts",
    "voice": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/lab-voice-cli.ts",
    "live-stub": "node --disable-warning=ExperimentalWarning --experimental-strip-types integrations/openbot-live/src/cli.ts",
    "voice-joint": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/voice-joint-cli.ts",
    "device-edge-auth": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/device-edge-auth-proxy-cli.ts",
    "voice-harness": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/voice-harness-cli.ts",
    "voice-harness:sim": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/voice-harness-cli.ts --sim"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@evan/opus": "^1.0.3"
  }
}
