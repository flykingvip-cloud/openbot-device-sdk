{
  "name": "openbot-device-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Agent A device platform: Metalio voice adapter, device tools/media, and a lab-only claim/bind/OTA control plane.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "console": "node --disable-warning=ExperimentalWarning --experimental-strip-types console/src/cli.ts",
    "sim": "node --disable-warning=ExperimentalWarning --experimental-strip-types simulator/src/cli.ts",
    "ota-config": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/ota-config-cli.ts",
    "voice": "node --disable-warning=ExperimentalWarning --experimental-strip-types services/src/lab-voice-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}
