# Example only — deploy path on HK: /etc/nginx/conf.d/device-lab.openbot.love.conf
# Requires: DNS A device-lab.openbot.love → 8.217.93.71
#           certbot cert for device-lab.openbot.love
# Lab process must listen 127.0.0.1:8002 (OTA) and 127.0.0.1:8791 (voice)

upstream device_lab_ota {
    server 127.0.0.1:8002;
    keepalive 8;
}

upstream device_lab_voice {
    server 127.0.0.1:8791;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name device-lab.openbot.love;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name device-lab.openbot.love;

    ssl_certificate     /etc/letsencrypt/live/device-lab.openbot.love/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/device-lab.openbot.love/privkey.pem;

    access_log /var/log/nginx/device-lab.openbot.love.access.log;
    error_log  /var/log/nginx/device-lab.openbot.love.error.log;

    # Xiaozhi OTA — keep trailing-slash semantics
    location ^~ /xiaozhi/ota/ {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://device_lab_ota;
    }

    # Voice WebSocket (and any non-OTA HTTP on the voice listener)
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_pass http://device_lab_voice;
    }
}
